# =============================================================================
# Plantilla de variables de entorno - Modulo X (Twitter) via TwitterAPI.io
# =============================================================================
# Uso:
#   1. Copiar este archivo a `.env` en la misma carpeta:
#        cp .env.example .env
#   2. Editar `.env` con los valores reales (NO editar este archivo).
#   3. `.env` esta en .gitignore - nunca sera commiteado.
#
# Proveedor: TwitterAPI.io (terceros, no afiliado a X Corp)
#   Alta:      https://twitterapi.io (login con Google; cuenta del proyecto)
#   API key:   Dashboard -> API Key
#   Precios:   https://twitterapi.io/pricing (USD 0.15 por 1,000 tweets)
#   Academico: solicitado a hello@twitterapi.io (jul 2026)
# =============================================================================

# --- Credencial TwitterAPI.io ---
# Header HTTP: X-API-Key
TWITTERAPI_IO_KEY=replace_with_api_key

# --- Control de costo ---
# Tope duro de tweets por corrida (el colector se detiene al alcanzarlo).
# 500 tweets ~ USD 0.075 (cabe en el credito gratis de USD 0.10)
MAX_TWEETS_PER_RUN=500

# =============================================================================
# Rutas de almacenamiento fisico
# =============================================================================
# Disco 4 - Otras plataformas (X vive aqui segun el Plan de Ingestion X)
DATA_ROOT_OTHER_PLATFORMS=/Volumes/Disco4/thesis_other_platforms

# Mientras no este montado el Disco 4, usar data/ local (en .gitignore)
DATA_ROOT_LOCAL=data

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/x_pipeline.log
